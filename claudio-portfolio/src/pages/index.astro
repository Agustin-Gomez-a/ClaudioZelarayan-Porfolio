---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import balca from '../assets/work/balca-premixer.jpg';
import claudio from '../assets/work/claudio-illustration.jpg';
import samsara from '../assets/work/samsara-candle.jpg';
import esports from '../assets/work/team-escandor.jpg';
import apparel from '../assets/work/ay-amor.jpg';
import illustration from '../assets/work/ilustracion-creativa.jpg';
import messi from '../assets/work/messi-poster.jpg';

const projects = [
  {
    number: '01',
    title: 'Balca / Premixer',
    category: 'Branding · Packaging',
    tag: 'branding',
    image: balca,
    alt: 'Diseño de etiqueta para productos químicos de Balca',
    description: 'Identidad visual, etiquetas, packaging, flyers y catálogos para Balca; piezas de comunicación para Premixer.',
    layout: 'feature',
    tone: 'lime',
  },
  {
    number: '02',
    title: 'Team Escandor',
    category: 'E-sports · Identidad',
    tag: 'identidad',
    image: esports,
    alt: 'Identidad ilustrada para un equipo de e-sports',
    description: 'Una marca con energía gamer: ilustración de personaje, emblema y piezas de marketing digital para el equipo.',
    layout: 'standard',
    tone: 'red',
  },
  {
    number: '03',
    title: 'Samsara · Hecho con magia',
    category: 'Emprendimientos · Identidad',
    tag: 'branding',
    image: samsara,
    alt: 'Pieza visual de Samsara, velas artesanales hechas con magia',
    description: 'Una identidad cálida y expresiva para un emprendimiento, con una dirección visual pensada para destacar en redes.',
    layout: 'standard',
    tone: 'lilac',
  },
  {
    number: '04',
    title: 'Ay Amor',
    category: 'Indumentaria · Ilustración',
    tag: 'ilustracion',
    image: apparel,
    alt: 'Ilustración Ay Amor para diseño de indumentaria',
    description: 'Una ilustración original convertida en una pieza protagonista para indumentaria y comunicación visual.',
    layout: 'standard',
    tone: 'pink',
  },
  {
    number: '05',
    title: 'Messi · For Fun',
    category: 'Concursos · Ilustración',
    tag: 'ilustracion',
    image: messi,
    alt: 'Afiche ilustrado de Lionel Messi levantando la copa',
    description: 'Afiche ilustrado con una mirada celebratoria, color y narrativa gráfica para proyectos y concursos creativos.',
    layout: 'standard',
    tone: 'blue',
  },
  {
    number: '06',
    title: 'Criaturas & personajes',
    category: 'Hobby · Ilustración digital',
    tag: 'ilustracion',
    image: illustration,
    alt: 'Ilustración digital de un personaje original',
    description: 'Un espacio para experimentar con personajes, gesto y color, y seguir alimentando la curiosidad visual.',
    layout: 'wide',
    tone: 'peach',
  },
];

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/cclaud10ss/' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/claudio-zelarayan-878120231/' },
  { label: 'Facebook', href: 'https://www.facebook.com/cclaud10ss/' },
];
---

<Layout
  title="Claudio Zelarayan — Diseñador gráfico"
  description="Portfolio de Claudio Zelarayan, diseñador gráfico freelance en Tucumán. Branding, packaging, ilustración y diseño digital. Más de 5 años de experiencia y 100+ proyectos."
>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <div class="scroll-progress" aria-hidden="true"><span id="scroll-progress-bar"></span></div>

  <header class="site-header" id="inicio">
    <a class="brand-mark" href="#inicio" aria-label="Claudio Zelarayan, inicio">
      <span class="brand-monogram">
        <span class="monogram-text">Cz</span>
      </span>
      <span class="brand-name">Claudio<br />Zelarayan</span>
    </a>
    <nav class="desktop-nav" aria-label="Navegación principal">
      <a href="#trabajos">Trabajos <span>06</span></a>
      <a href="#sobre-mi">Sobre mí</a>
      <a class="nav-contact" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
    </nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
      <span></span><span></span>
    </button>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Navegación móvil" hidden>
      <a href="#trabajos">Trabajos <span>06</span></a>
      <a href="#sobre-mi">Sobre mí</a>
      <a href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="contenido">
    <section class="hero section-pad" aria-labelledby="hero-title">
      <div class="hero-ambient" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow"><span class="availability-dot"></span> Diseñador gráfico · Tucumán, Argentina</p>
        <h1 id="hero-title">Diseño que<br /><span>hace</span> <em>ruido.</em></h1>
        <div class="hero-bottom">
          <p class="hero-intro">Le doy forma a ideas con carácter. <strong>Marcas, imágenes y experiencias</strong> que se hacen notar y se quedan en la memoria.</p>
          <div class="hero-actions">
            <a class="hero-cta-primary" href="#trabajos" aria-label="Explorar proyectos">
              <span>Explorar trabajos</span>
              <span class="cta-arrow-circle" aria-hidden="true">↓</span>
            </a>
            <a class="hero-cta-secondary" href="#contacto" aria-label="Ir a contacto">
              <span>Hablemos</span>
              <span class="cta-arrow-corner" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
      <div class="hero-art" aria-label="Retrato ilustrado de Claudio Zelarayan">
        <div class="hero-art-grid" aria-hidden="true"></div>
        <div class="hero-sticker sticker-top" aria-hidden="true"><span>Ideas</span><span>con</span><span>actitud</span></div>
        <div class="hero-image-frame" data-parallax="0.04">
          <Image src={claudio} alt="Retrato ilustrado de Claudio Zelarayan" widths={[420, 680, 900]} sizes="(max-width: 800px) 80vw, 42vw" format="webp" quality={84} loading="eager" fetchpriority="high" />
        </div>
        <div class="hero-art-orbit" aria-hidden="true">C</div>
        <p class="hero-art-note" aria-hidden="true"><span>Diseño</span><span>con intención</span></p>
        <span class="hero-spark hero-spark-one" aria-hidden="true">✳</span>
        <span class="hero-spark hero-spark-two" aria-hidden="true">+</span>
      </div>
      <div class="hero-index" aria-hidden="true"><span>01</span><span class="hero-index-line"></span><span>Scroll para descubrir</span></div>
    </section>

    <div class="ticker" aria-label="Branding, packaging, ilustración y diseño digital">
      <div class="ticker-inner">
        <div class="ticker-track" aria-hidden="true">
          {Array.from({ length: 8 }).map(() => (
            <span class="ticker-chunk">
              <span>Branding</span><i class="ticker-dot">✳</i>
              <span>Packaging</span><i class="ticker-dot">✳</i>
              <span>Ilustración</span><i class="ticker-dot">✳</i>
              <span>Diseño digital</span><i class="ticker-dot">✳</i>
            </span>
          ))}
        </div>
      </div>
    </div>

    <section class="work-section section-pad" id="trabajos" aria-labelledby="work-title">
      <div class="section-heading" data-reveal>
        <div class="section-heading-main">
          <p class="eyebrow eyebrow-dark"><span>01</span> Selección de trabajos</p>
          <h2 id="work-title">Una idea.<br /><em>Muchas formas.</em></h2>
        </div>
        <div class="work-statement-card">
          <span class="statement-badge">Manifiesto visual</span>
          <p class="statement-lead">
            Identidades que cuentan <strong>historias</strong>.<br />
            Piezas hechas para vivir en una <strong>pantalla</strong>, en la <strong>calle</strong> y en las <strong>manos</strong>.
          </p>
        </div>
      </div>

      <!-- Project Category Filters -->
      <div class="project-filters" data-reveal role="tablist" aria-label="Filtrar proyectos">
        <button class="filter-pill is-active" type="button" data-filter="all">Todos <span>(06)</span></button>
        <button class="filter-pill" type="button" data-filter="branding">Branding & Packaging <span>(02)</span></button>
        <button class="filter-pill" type="button" data-filter="ilustracion">Ilustración & Arte <span>(03)</span></button>
        <button class="filter-pill" type="button" data-filter="identidad">Identidad & E-sports <span>(01)</span></button>
      </div>

      <div class="project-grid" id="project-grid">
        {projects.map((project, index) => (
          <article
            class:list={["project-card", `project-card--${project.layout}`, `project-card--${project.tone}`]}
            data-reveal
            data-category={project.tag}
          >
            <button
              class="project-card-button"
              type="button"
              aria-haspopup="dialog"
              aria-label={`Ver proyecto ${project.title}`}
              data-project-index={index}
              data-project-title={project.title}
              data-project-category={project.category}
              data-project-description={project.description}
              data-project-image={project.image.src}
              data-project-alt={project.alt}
            >
              <span class="project-image-wrap">
                <Image src={project.image} alt={project.alt} widths={[420, 720, 1040]} sizes="(max-width: 720px) 92vw, (max-width: 1100px) 46vw, 36vw" format="webp" quality={82} loading="lazy" />
                <span class="project-image-shade" aria-hidden="true"></span>
                <span class="project-open" aria-hidden="true">↗</span>
                <span class="project-number">{project.number} / 06</span>
              </span>
              <span class="project-meta">
                <span><span class="project-category">{project.category}</span><strong>{project.title}</strong></span>
                <span class="project-arrow" aria-hidden="true">↗</span>
              </span>
            </button>
          </article>
        ))}
      </div>

      <div class="work-footnote" data-reveal><span>Un archivo en constante movimiento</span><span class="footnote-line"></span><span>2021 — hoy</span></div>
    </section>

    <section class="case-section" aria-labelledby="case-title">
      <div class="case-visual" data-reveal>
        <div class="case-stamp" aria-hidden="true">CASO<br />DESTACADO<br /><span>№ 01</span></div>
        <div class="case-image" data-parallax="0.03">
          <Image src={balca} alt="Etiqueta y empaque diseñado para Balca" widths={[500, 800, 1100]} sizes="(max-width: 900px) 100vw, 52vw" format="webp" quality={84} loading="lazy" />
        </div>
        <span class="case-corner-mark" aria-hidden="true">✳</span>
      </div>
      <div class="case-copy" data-reveal>
        <p class="eyebrow"><span>Un proyecto, de punta a punta</span></p>
        <h2 id="case-title">Balca<br /><em>se pone</em><br />en marcha.</h2>
        <p>Identidad visual para una empresa de químicos: logotipo, etiquetas, empaques, flyers y catálogos. También piezas gráficas para Premixer, con una misma prioridad: que cada marca comunique claro y con coherencia.</p>
      <div class="case-tags flex flex-wrap gap-2"><span>Identidad</span><span>Packaging</span><span>Impresos</span></div>
        <a class="text-link text-link-light" href="#contacto">¿Tenés un proyecto parecido? <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="about-section section-pad" id="sobre-mi" aria-labelledby="about-title">
      <div class="about-kicker" data-reveal><p class="eyebrow eyebrow-dark"><span>02</span> Un poco sobre mí</p><span class="about-asterisk" aria-hidden="true">✳</span></div>
      <div class="about-main">
        <div class="about-statement" data-reveal>
          <h2 id="about-title">No hago<br />diseños <em>porque sí.</em></h2>
          <p>Me gusta encontrar lo que hace única a cada idea y convertirlo en una imagen que conecte. Soy Claudio, diseñador gráfico freelance, curioso por naturaleza y fan de los detalles que cambian todo.</p>
          <a class="text-link" href="#contacto">Conoceme en un proyecto <span aria-hidden="true">↗</span></a>
        </div>
        <div class="about-facts" data-reveal>
          <div class="fact">
            <strong class="stat-counter" data-count-target="5" data-count-prefix="0" data-count-suffix="+">05<span>+</span></strong>
            <span>Años haciendo<br />que las ideas se vean</span>
          </div>
          <div class="fact">
            <strong class="stat-counter" data-count-target="100" data-count-prefix="" data-count-suffix="+">100<span>+</span></strong>
            <span>Proyectos<br />en el camino</span>
          </div>
          <div class="fact-location"><span class="availability-dot"></span> Tucumán, Argentina<br /><span>Trabajo con marcas de cualquier lugar.</span></div>
        </div>
      </div>
      <div class="about-bottom"><span>Una mirada curiosa</span><span>Una identidad propia</span><span>Un resultado que funciona</span></div>
    </section>

    <section class="services-section section-pad" aria-labelledby="services-title">
      <div class="services-intro" data-reveal>
        <p class="eyebrow"><span>03</span> Qué puedo hacer por tu marca</p>
        <h2 id="services-title">Del primer<br /><em>trazo al mundo.</em></h2>
      </div>
      <div class="services-list">
        <article class="service-item" data-reveal>
          <span class="service-no">01</span><h3>Identidad de marca</h3><p>Logotipo, sistema visual y lineamientos para que tu marca se reconozca en todos sus puntos de contacto.</p><span class="service-glyph" aria-hidden="true">✳</span>
        </article>
        <article class="service-item" data-reveal>
          <span class="service-no">02</span><h3>Packaging & impresos</h3><p>Etiquetas, empaques, catálogos, flyers y piezas listas para salir del archivo y llegar a la gente.</p><span class="service-glyph" aria-hidden="true">▧</span>
        </article>
        <article class="service-item" data-reveal>
          <span class="service-no">03</span><h3>Diseño digital</h3><p>Piezas para redes, campañas y experiencias web pensadas para verse bien y comunicar rápido.</p><span class="service-glyph" aria-hidden="true">↗</span>
        </article>
        <article class="service-item" data-reveal>
          <span class="service-no">04</span><h3>Ilustración</h3><p>Personajes, recursos y arte original para sumar personalidad a una idea, una prenda o una historia.</p><span class="service-glyph" aria-hidden="true">⌁</span>
        </article>
      </div>
    </section>

    <!-- Caja de Herramientas Renovada con Entidad y Estructura -->
    <section class="toolbelt-section section-pad" aria-labelledby="toolbelt-title">
      <div class="toolbelt-header" data-reveal>
        <div class="toolbelt-heading">
          <p class="eyebrow toolbelt-eyebrow"><span>04 · Dominio técnico & software</span></p>
          <h2 id="toolbelt-title">Mi caja de<br /><em>herramientas.</em></h2>
        </div>
        <p class="toolbelt-lead">
          El criterio no sirve si no sabés ejecutarlo. Manejo software profesional de la industria y procesos de producción técnica para llevar cualquier idea de la pantalla a la calle, la tela o la imprenta.
        </p>
      </div>

      <div class="toolbelt-grid">
        <article class="tool-card tool-card--ps" data-reveal>
          <div class="tool-card-head">
            <span class="tool-icon tool-icon--ps">Ps</span>
            <span class="tool-pill">Adobe</span>
          </div>
          <h3>Photoshop</h3>
          <p class="tool-desc">Retoque digital avanzado, fotomontajes de alto impacto, texturas, corrección de color y arte final publicitario.</p>
          <span class="tool-feature">Retoque & Composición</span>
        </article>

        <article class="tool-card tool-card--ai" data-reveal>
          <div class="tool-card-head">
            <span class="tool-icon tool-icon--ai">Ai</span>
            <span class="tool-pill">Adobe</span>
          </div>
          <h3>Illustrator</h3>
          <p class="tool-desc">Diseño vectorial de identidades, logotipos, sistemas de marca, afiches e ilustración gráfica de máxima precisión.</p>
          <span class="tool-feature">Vectores & Branding</span>
        </article>

        <article class="tool-card tool-card--cd" data-reveal>
          <div class="tool-card-head">
            <span class="tool-icon tool-icon--cd">Cd</span>
            <span class="tool-pill">Preprensa</span>
          </div>
          <h3>CorelDRAW</h3>
          <p class="tool-desc">Archivos listos para producción: cartelería, gigantografías, rotulación vehicular, ploteos y separación de colores.</p>
          <span class="tool-feature">Impresión & Plotter</span>
        </article>

        <article class="tool-card tool-card--sb" data-reveal>
          <div class="tool-card-head">
            <span class="tool-icon tool-icon--sb">Sb</span>
            <span class="tool-pill">Ilustración</span>
          </div>
          <h3>Sketchbook</h3>
          <p class="tool-desc">Bocetado rápido a mano alzada, creación de personajes, soltura de trazo y exploración visual de ideas antes de vectorizar.</p>
          <span class="tool-feature">Concept & Bocetos</span>
        </article>

        <article class="tool-card tool-card--app" data-reveal>
          <div class="tool-card-head">
            <span class="tool-icon tool-icon--app">In</span>
            <span class="tool-pill">Textil</span>
          </div>
          <h3>Indumentaria</h3>
          <p class="tool-desc">Diseño de estampas para serigrafía, DTF y sublimación, rapport textil, figurines y fichas técnicas completas para confección.</p>
          <span class="tool-feature">Estampas & Fichas</span>
        </article>

        <article class="tool-card tool-card--cv" data-reveal>
          <div class="tool-card-head">
            <span class="tool-icon tool-icon--cv">Cv</span>
            <span class="tool-pill">Ágil</span>
          </div>
          <h3>Canva & Office</h3>
          <p class="tool-desc">Armado de plantillas editables para que los clientes gestionen sus redes, y presentaciones corporativas claras y dinámicas.</p>
          <span class="tool-feature">Sistemas Editables</span>
        </article>
      </div>

      <div class="toolbelt-footer-bar" data-reveal>
        <span class="toolbelt-badge">Especialidades & Métodos:</span>
        <div class="toolbelt-pills">
          <span>Brief & Estrategia</span>
          <span>Bocetado Conceptual</span>
          <span>Vector & Ajuste Fino</span>
          <span>Archivos de Producción</span>
          <span>Acompañamiento en Imprenta</span>
        </div>
      </div>
    </section>

    <section class="contact-section section-pad" id="contacto" aria-labelledby="contact-title">
      <div class="contact-top" data-reveal>
        <p class="eyebrow contact-eyebrow"><span>05</span> Hagamos algo que valga la pena</p>
        <span class="contact-doodle" aria-hidden="true">✳</span>
      </div>
      <div class="contact-heading" data-reveal>
        <h2 id="contact-title">¿Qué idea<br /><em>tenés dando vueltas?</em></h2>
        <a class="contact-send" href="mailto:claudiomarcelozelarayan.cmz@gmail.com?subject=Hablemos%20de%20un%20proyecto" aria-label="Escribirle a Claudio por correo">
          <span>Escribime</span><span aria-hidden="true">↗</span>
        </a>
      </div>
      <form class="contact-form" id="contact-form" action="mailto:claudiomarcelozelarayan.cmz@gmail.com" method="post" enctype="text/plain" data-reveal>
        <div class="contact-form-heading"><span>Contame un poco</span><span>Te leo →</span></div>
        <div class="contact-form-fields">
          <label>Tu nombre<input name="name" autocomplete="name" required placeholder="¿Cómo te llamás?" /></label>
          <label>Tu correo<input name="email" type="email" autocomplete="email" required placeholder="nombre@correo.com" /></label>
          <label class="contact-brief">¿Qué tenés en mente?<textarea name="brief" rows="2" required placeholder="Una marca, una idea, algo por diseñar…"></textarea></label>
          <button class="contact-submit" type="submit">Preparar mensaje <span aria-hidden="true">↗</span></button>
        </div>
      </form>
      <div class="contact-bottom">
        <div class="contact-detail"><span>Correo</span><a href="mailto:claudiomarcelozelarayan.cmz@gmail.com">claudiomarcelozelarayan.cmz@gmail.com</a></div>
        <div class="contact-detail"><span>También por WhatsApp</span><a href="https://wa.me/5493815041364?text=Hola%20Claudio%2C%20quiero%20consultarte%20por%20un%20proyecto" target="_blank" rel="noreferrer">+54 9 381 504 1364 <span aria-hidden="true">↗</span></a></div>
        <span class="contact-place">Tucumán, Argentina</span>
      </div>
    </section>
  </main>

  <button class="back-to-top" id="back-to-top" type="button" aria-label="Volver al inicio" title="Volver al inicio">
    <span class="back-to-top-icon" aria-hidden="true">↑</span>
    <span class="back-to-top-text">Subir</span>
  </button>

  <footer class="site-footer section-pad">
    <div class="footer-col-brand">
      <a class="footer-signature" href="#inicio">Claudio<br /><em>Zelarayan.</em></a>
    </div>
    <div class="footer-col-desc">
      <p>Diseño gráfico freelance<br />para ideas que quieren hacerse ver.</p>
    </div>
    <div class="footer-col-socials">
      <div class="footer-socials flex flex-wrap gap-2" aria-label="Redes sociales">
        {socials.map((social) => <a href={social.href} target="_blank" rel="noreferrer">{social.label}<span aria-hidden="true">↗</span></a>)}
      </div>
    </div>
    <div class="footer-col-copy">
      <span class="footer-copyright">© {new Date().getFullYear()} · Hecho en Tucumán</span>
    </div>
  </footer>

  <dialog class="project-dialog" id="project-dialog" aria-labelledby="dialog-title">
    <button class="dialog-close" type="button" aria-label="Cerrar proyecto">×</button>
    <div class="dialog-image-wrap"><img id="dialog-image" src="" alt="" /><span id="dialog-index" class="project-number"></span></div>
    <div class="dialog-copy">
      <p class="eyebrow eyebrow-dark" id="dialog-category"></p>
      <h2 id="dialog-title"></h2>
      <p id="dialog-description"></p>
      <a class="text-link" href="#contacto" id="dialog-contact">Hablemos de una idea así <span aria-hidden="true">↗</span></a>
    </div>
  </dialog>

  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    const progressBar = document.querySelector<HTMLElement>('#scroll-progress-bar');
    const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
    const projectDialog = document.querySelector<HTMLDialogElement>('#project-dialog');
    const dialogImage = document.querySelector<HTMLImageElement>('#dialog-image');
    const dialogTitle = document.querySelector<HTMLElement>('#dialog-title');
    const dialogCategory = document.querySelector<HTMLElement>('#dialog-category');
    const dialogDescription = document.querySelector<HTMLElement>('#dialog-description');
    const dialogIndex = document.querySelector<HTMLElement>('#dialog-index');

    if (reduceMotion.matches || !('IntersectionObserver' in window)) {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    } else {
      document.documentElement.classList.add('motion-ready');
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      revealItems.forEach((item, index) => {
        item.style.setProperty('--reveal-delay', `${Math.min(index % 4, 3) * 70}ms`);
        revealObserver.observe(item);
      });
    }

    // Floating Back to Top Button
    const backToTopBtn = document.querySelector<HTMLButtonElement>('#back-to-top');
    const updateBackToTop = () => {
      if (window.scrollY > 380) {
        backToTopBtn?.classList.add('is-visible');
      } else {
        backToTopBtn?.classList.remove('is-visible');
      }
    };
    window.addEventListener('scroll', updateBackToTop, { passive: true });
    updateBackToTop();

    backToTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Dynamic number counter animation for stats
    const counterElements = document.querySelectorAll<HTMLElement>('.stat-counter');
    if ('IntersectionObserver' in window && !reduceMotion.matches) {
      const counterObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = parseInt(el.dataset.countTarget || '0', 10);
            const prefix = el.dataset.countPrefix || '';
            const suffix = el.dataset.countSuffix || '+';
            const duration = 1600;
            const startTime = performance.now();

            const updateCount = (currentTime: number) => {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              // Ease-out cubic
              const easeOut = 1 - Math.pow(1 - progress, 3);
              const currentVal = Math.floor(easeOut * target);

              const formatted = prefix ? `${prefix}${currentVal}` : `${currentVal}`;
              el.innerHTML = `${formatted}<span>${suffix}</span>`;

              if (progress < 1) {
                requestAnimationFrame(updateCount);
              } else {
                const finalFormatted = prefix ? `${prefix}${target}` : `${target}`;
                el.innerHTML = `${finalFormatted}<span>${suffix}</span>`;
              }
            };

            requestAnimationFrame(updateCount);
            observer.unobserve(el);
          }
        });
      }, { threshold: 0.35 });

      counterElements.forEach((el) => counterObserver.observe(el));
    }

    // Category Filter Buttons for Projects
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const filter = btn.dataset.filter || 'all';

        projectCards.forEach((card) => {
          const category = card.dataset.category;
          if (filter === 'all' || category === filter) {
            card.style.display = '';
            card.classList.remove('is-filtered-out');
          } else {
            card.style.display = 'none';
            card.classList.add('is-filtered-out');
          }
        });
      });
    });

    // Subtle 3D mouse tilt on hero portrait (desktop only)
    const heroArt = document.querySelector<HTMLElement>('.hero-art');
    const heroFrame = document.querySelector<HTMLElement>('.hero-image-frame');
    if (heroArt && heroFrame && !reduceMotion.matches && window.innerWidth >= 900) {
      heroArt.addEventListener('mousemove', (e) => {
        const rect = heroArt.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        const rotateY = x * 10;
        const rotateX = -y * 10;
        heroFrame.style.transform = `perspective(900px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) rotate(4deg) translateY(var(--parallax-shift, 0px))`;
      });
      heroArt.addEventListener('mouseleave', () => {
        heroFrame.style.transform = 'perspective(900px) rotate(4deg) translateY(var(--parallax-shift, 0px))';
      });
    }

    let ticking = false;
    const parallaxItems = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
    const updateScrollMotion = () => {
      const fullHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = fullHeight > 0 ? window.scrollY / fullHeight : 0;
      progressBar?.style.setProperty('transform', `scaleX(${Math.min(1, Math.max(0, progress))})`);

      if (!reduceMotion.matches && window.innerWidth >= 800) {
        parallaxItems.forEach((item) => {
          const rect = item.getBoundingClientRect();
          if (rect.bottom > 0 && rect.top < window.innerHeight) {
            const speed = Number(item.dataset.parallax || 0.03);
            const shift = (rect.top + rect.height / 2 - window.innerHeight / 2) * -speed;
            item.style.setProperty('--parallax-shift', `${shift.toFixed(1)}px`);
          }
        });
      }
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateScrollMotion);
        ticking = true;
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateScrollMotion();

    menuToggle?.addEventListener('click', () => {
      const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!isOpen));
      menuToggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
      if (mobileMenu) mobileMenu.hidden = isOpen;
    });
    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      mobileMenu.hidden = true;
      menuToggle?.setAttribute('aria-expanded', 'false');
      menuToggle?.setAttribute('aria-label', 'Abrir menú');
    }));

    document.querySelectorAll<HTMLButtonElement>('[data-project-index]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!projectDialog || !dialogImage || !dialogTitle || !dialogCategory || !dialogDescription || !dialogIndex) return;
        dialogImage.src = button.dataset.projectImage || '';
        dialogImage.alt = button.dataset.projectAlt || '';
        dialogTitle.textContent = button.dataset.projectTitle || '';
        dialogCategory.textContent = button.dataset.projectCategory || '';
        dialogDescription.textContent = button.dataset.projectDescription || '';
        dialogIndex.textContent = `${String(Number(button.dataset.projectIndex) + 1).padStart(2, '0')} / 06`;
        projectDialog.showModal();
      });
    });
    document.querySelector<HTMLButtonElement>('.dialog-close')?.addEventListener('click', () => projectDialog?.close());
    projectDialog?.addEventListener('click', (event) => {
      if (event.target === projectDialog) projectDialog.close();
    });
    document.querySelector<HTMLAnchorElement>('#dialog-contact')?.addEventListener('click', () => projectDialog?.close());

    document.querySelector<HTMLFormElement>('#contact-form')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const form = event.currentTarget as HTMLFormElement;
      if (!form.reportValidity()) return;
      const formData = new FormData(form);
      const subject = encodeURIComponent(`Consulta de ${formData.get('name')}`);
      const body = encodeURIComponent(`Hola Claudio, soy ${formData.get('name')} (${formData.get('email')}).\n\n${formData.get('brief')}`);
      window.location.href = `mailto:claudiomarcelozelarayan.cmz@gmail.com?subject=${subject}&body=${body}`;
    });
  </script>
</Layout>
