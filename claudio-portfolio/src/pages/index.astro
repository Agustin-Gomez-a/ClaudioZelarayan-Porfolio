  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    const progressBar = document.querySelector<HTMLElement>('#scroll-progress-bar');
    const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu');
    const projectDialog = document.querySelector<HTMLDialogElement>('#project-dialog');
    const dialogImage = document.querySelector<HTMLImageElement>('#dialog-image');
    const dialogTitle = document.querySelector<HTMLElement>('#dialog-title');
    const dialogCategory = document.querySelector<HTMLElement>('#dialog-category');
    const dialogDescription = document.querySelector<HTMLElement>('#dialog-description');

    // Typewriter effect on "ruido." with 3 complementary variations
    const typewriterEl = document.getElementById('typewriter-text');
    if (typewriterEl) {
      const words = ['ruido.', 'marca.', 'foco.', 'eco.'];
      let wordIndex = 0;
      let charIndex = words[0].length;
      let isDeleting = true;

      const typeLoop = () => {
        const currentWord = words[wordIndex];

        if (isDeleting) {
          charIndex--;
          typewriterEl.textContent = currentWord.substring(0, charIndex);
          if (charIndex === 0) {
            isDeleting = false;
            wordIndex = (wordIndex + 1) % words.length;
            setTimeout(typeLoop, 320);
            return;
          }
          setTimeout(typeLoop, 55);
        } else {
          charIndex++;
          typewriterEl.textContent = currentWord.substring(0, charIndex);
          if (charIndex === currentWord.length) {
            isDeleting = true;
            setTimeout(typeLoop, 2100);
            return;
          }
          setTimeout(typeLoop, 90);
        }
      };

      // Start delete effect smoothly after initial load
      setTimeout(typeLoop, 1400);
    }

    // Progressive smooth reveal as user scrolls down
    if (!('IntersectionObserver' in window)) {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    } else {
      document.documentElement.classList.add('motion-ready');
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -45px 0px' });

      revealItems.forEach((item, index) => {
        item.style.setProperty('--reveal-delay', `${(index % 3) * 90}ms`);
        revealObserver.observe(item);
      });
    }

    // Smooth scrolling for all internal anchor links
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', (e) => {
        const hash = anchor.getAttribute('href');
        if (!hash || hash === '#') return;
        const target = document.querySelector<HTMLElement>(hash);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          if (history.pushState) {
            history.pushState(null, '', hash);
          }
        }
      });
    });

    // Floating Back to Top Button
    const backToTopBtn = document.querySelector<HTMLButtonElement>('#back-to-top');
    const updateBackToTop = () => {
      if (window.scrollY > 380) {
        backToTopBtn?.classList.add('is-visible');
      } else {
        backToTopBtn?.classList.remove('is-visible');
      }
    };
    window.addEventListener('scroll', updateBackToTop, { passive: true });
    updateBackToTop();

    backToTopBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Dynamic number counter animation for stats
    const counterElements = document.querySelectorAll<HTMLElement>('.stat-counter');
    if ('IntersectionObserver' in window) {
      const counterObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = parseInt(el.dataset.countTarget || '0', 10);
            const prefix = el.dataset.countPrefix || '';
            const suffix = el.dataset.countSuffix || '+';
            const duration = 1600;
            const startTime = performance.now();

            const updateCount = (currentTime: number) => {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              // Ease-out cubic
              const easeOut = 1 - Math.pow(1 - progress, 3);
              const currentVal = Math.floor(easeOut * target);

              const formatted = prefix ? `${prefix}${currentVal}` : `${currentVal}`;
              el.innerHTML = `${formatted}<span>${suffix}</span>`;

              if (progress < 1) {
                requestAnimationFrame(updateCount);
              } else {
                const finalFormatted = prefix ? `${prefix}${target}` : `${target}`;
                el.innerHTML = `${finalFormatted}<span>${suffix}</span>`;
              }
            };

            requestAnimationFrame(updateCount);
            observer.unobserve(el);
          }
        });
      }, { threshold: 0.25 });

      counterElements.forEach((el) => counterObserver.observe(el));
    }

    // Category Filter Buttons for Projects
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const filter = btn.dataset.filter || 'all';

        projectCards.forEach((card) => {
          const category = card.dataset.category;
          if (filter === 'all' || category === filter) {
            card.style.display = '';
            card.classList.remove('is-filtered-out');
          } else {
            card.style.display = 'none';
            card.classList.add('is-filtered-out');
          }
        });
      });
    });

    // Subtle 3D mouse tilt on hero portrait (desktop only)
    const heroArt = document.querySelector<HTMLElement>('.hero-art');
    const heroFrame = document.querySelector<HTMLElement>('.hero-image-frame');
    if (heroArt && heroFrame && window.innerWidth >= 900) {
      heroArt.addEventListener('mousemove', (e) => {
        const rect = heroArt.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        const rotateY = x * 10;
        const rotateX = -y * 10;
        heroFrame.style.transform = `perspective(900px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) rotate(4deg) translateY(var(--parallax-shift, 0px))`;
      });
      heroArt.addEventListener('mouseleave', () => {
        heroFrame.style.transform = 'perspective(900px) rotate(4deg) translateY(var(--parallax-shift, 0px))';
      });
    }

    let ticking = false;
    const parallaxItems = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
    const updateScrollMotion = () => {
      const fullHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = fullHeight > 0 ? window.scrollY / fullHeight : 0;
      progressBar?.style.setProperty('transform', `scaleX(${Math.min(1, Math.max(0, progress))})`);

      if (window.innerWidth >= 800) {
        parallaxItems.forEach((item) => {
          const rect = item.getBoundingClientRect();
          if (rect.bottom > 0 && rect.top < window.innerHeight) {
            const speed = Number(item.dataset.parallax || 0.03);
            const shift = (rect.top + rect.height / 2 - window.innerHeight / 2) * -speed;
            item.style.setProperty('--parallax-shift', `${shift.toFixed(1)}px`);
          }
        });
      }
      ticking = false;
    };
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateScrollMotion);
        ticking = true;
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateScrollMotion();

    menuToggle?.addEventListener('click', () => {
      const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!isOpen));
      menuToggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
      if (mobileMenu) mobileMenu.hidden = isOpen;
    });
    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      mobileMenu.hidden = true;
      menuToggle?.setAttribute('aria-expanded', 'false');
      menuToggle?.setAttribute('aria-label', 'Abrir menú');
    }));

    // Interactive Multi-Media Gallery Logic
    interface MediaItem {
      type: 'image' | 'video';
      src: string;
      alt?: string;
      label?: string;
    }
    interface ProjectData {
      number: string;
      title: string;
      category: string;
      tag: string;
      coverImage: string;
      alt: string;
      description: string;
      deliverables?: string[];
      items: MediaItem[];
    }

    const projectsData: ProjectData[] = JSON.parse(document.getElementById('projects-data')?.textContent || '[]');
    let currentProjectIndex = 0;
    let currentItemIndex = 0;

    const dialogVideo = document.querySelector<HTMLVideoElement>('#dialog-video');
    const dialogPrevBtn = document.querySelector<HTMLButtonElement>('#dialog-prev-btn');
    const dialogNextBtn = document.querySelector<HTMLButtonElement>('#dialog-next-btn');
    const dialogItemCount = document.querySelector<HTMLElement>('#dialog-item-count');
    const dialogCaptionBar = document.querySelector<HTMLElement>('#dialog-caption-bar');
    const dialogCaptionText = document.querySelector<HTMLElement>('#dialog-caption-text');
    const dialogThumbnails = document.querySelector<HTMLElement>('#dialog-thumbnails');
    const dialogDeliverables = document.querySelector<HTMLElement>('#dialog-deliverables');
    const dialogProjectNo = document.querySelector<HTMLElement>('#dialog-project-no');
    const dialogPrevProject = document.querySelector<HTMLButtonElement>('#dialog-prev-project');
    const dialogNextProject = document.querySelector<HTMLButtonElement>('#dialog-next-project');
    const dialogMediaViewport = document.querySelector<HTMLElement>('#dialog-media-viewport');

    const renderItem = (itemIdx: number) => {
      const project = projectsData[currentProjectIndex];
      if (!project || !project.items || project.items.length === 0) return;

      currentItemIndex = ((itemIdx % project.items.length) + project.items.length) % project.items.length;
      const item = project.items[currentItemIndex];

      if (dialogItemCount) {
        dialogItemCount.textContent = `${currentItemIndex + 1} / ${project.items.length}`;
      }
      if (dialogCaptionText) {
        dialogCaptionText.textContent = item.label || item.alt || project.title;
      }

      if (item.type === 'video') {
        if (dialogImage) dialogImage.style.display = 'none';
        if (dialogVideo) {
          dialogVideo.style.display = 'block';
          if (dialogVideo.src !== item.src && !dialogVideo.src.endsWith(item.src)) {
            dialogVideo.src = item.src;
            dialogVideo.load();
          }
          dialogVideo.play().catch(() => {});
        }
      } else {
        if (dialogVideo) {
          dialogVideo.pause();
          dialogVideo.style.display = 'none';
        }
        if (dialogImage) {
          dialogImage.style.display = 'block';
          dialogImage.src = item.src;
          dialogImage.alt = item.alt || project.title;
        }
      }

      if (dialogThumbnails) {
        const thumbButtons = dialogThumbnails.querySelectorAll<HTMLButtonElement>('.dialog-thumb-btn');
        thumbButtons.forEach((btn, idx) => {
          btn.classList.toggle('is-active', idx === currentItemIndex);
        });
      }

      const hasMultiple = project.items.length > 1;
      if (dialogPrevBtn) dialogPrevBtn.style.display = hasMultiple ? 'grid' : 'none';
      if (dialogNextBtn) dialogNextBtn.style.display = hasMultiple ? 'grid' : 'none';
      if (dialogCaptionBar) dialogCaptionBar.style.display = (item.label || hasMultiple) ? 'flex' : 'none';
      if (dialogThumbnails) dialogThumbnails.style.display = hasMultiple ? 'flex' : 'none';
    };

    const renderThumbnails = () => {
      if (!dialogThumbnails) return;
      dialogThumbnails.innerHTML = '';
      const project = projectsData[currentProjectIndex];
      if (!project || project.items.length <= 1) {
        dialogThumbnails.style.display = 'none';
        return;
      }

      dialogThumbnails.style.display = 'flex';
      project.items.forEach((item, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `dialog-thumb-btn ${idx === currentItemIndex ? 'is-active' : ''}`;
        btn.setAttribute('aria-label', `Ver recurso ${idx + 1}: ${item.label || ''}`);
        
        if (item.type === 'video') {
          btn.innerHTML = `<span class="dialog-thumb-video"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg></span>`;
        } else {
          btn.innerHTML = `<img src="${item.src}" alt="${item.label || ''}" loading="lazy" />`;
        }

        btn.addEventListener('click', () => {
          renderItem(idx);
        });
        dialogThumbnails.appendChild(btn);
      });
    };

    const renderProject = (projectIdx: number, itemIdx = 0) => {
      currentProjectIndex = ((projectIdx % projectsData.length) + projectsData.length) % projectsData.length;
      const project = projectsData[currentProjectIndex];
      if (!project) return;

      if (dialogProjectNo) dialogProjectNo.textContent = `${project.number} / 07`;
      if (dialogCategory) dialogCategory.textContent = project.category;
      if (dialogTitle) dialogTitle.textContent = project.title;
      if (dialogDescription) dialogDescription.textContent = project.description;

      if (dialogDeliverables) {
        dialogDeliverables.innerHTML = (project.deliverables || [])
          .map((d) => `<span class="dialog-tag">${d}</span>`)
          .join('');
      }

      renderThumbnails();
      renderItem(itemIdx);
    };

    // Open dialog on project card click
    document.querySelectorAll<HTMLButtonElement>('[data-project-index]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!projectDialog) return;
        const pIdx = Number(button.dataset.projectIndex) || 0;
        renderProject(pIdx, 0);
        projectDialog.showModal();
      });
    });

    // Navigation inside project items (Prev / Next)
    dialogPrevBtn?.addEventListener('click', () => renderItem(currentItemIndex - 1));
    dialogNextBtn?.addEventListener('click', () => renderItem(currentItemIndex + 1));

    // Switch between projects (Prev / Next project)
    dialogPrevProject?.addEventListener('click', () => renderProject(currentProjectIndex - 1, 0));
    dialogNextProject?.addEventListener('click', () => renderProject(currentProjectIndex + 1, 0));

    // Keyboard navigation when dialog is active
    window.addEventListener('keydown', (e) => {
      if (!projectDialog || !projectDialog.open) return;
      if (e.key === 'ArrowRight') {
        renderItem(currentItemIndex + 1);
      } else if (e.key === 'ArrowLeft') {
        renderItem(currentItemIndex - 1);
      }
    });

    // Mobile touch swipe gestures
    let touchStartX = 0;
    let touchEndX = 0;
    dialogMediaViewport?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    dialogMediaViewport?.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 45) {
        if (diff > 0) {
          renderItem(currentItemIndex + 1);
        } else {
          renderItem(currentItemIndex - 1);
        }
      }
    }, { passive: true });

    // Safe close dialog with video cleanup
    const closeDialog = () => {
      if (dialogVideo) {
        dialogVideo.pause();
        dialogVideo.removeAttribute('src');
      }
      projectDialog?.close();
    };

    document.querySelector<HTMLButtonElement>('.dialog-close')?.addEventListener('click', closeDialog);
    projectDialog?.addEventListener('click', (event) => {
      if (event.target === projectDialog) closeDialog();
    });
    document.querySelector<HTMLAnchorElement>('#dialog-contact')?.addEventListener('click', closeDialog);

    const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
    const contactFeedback = document.querySelector<HTMLElement>('#contact-feedback');
    const contactSubmitBtn = document.querySelector<HTMLButtonElement>('#contact-submit-btn');
    const contactBtnLabel = document.querySelector<HTMLElement>('#contact-btn-label');
    const contactBtnIcon = document.querySelector<HTMLElement>('#contact-btn-icon');
    const feedbackGmailBtn = document.querySelector<HTMLAnchorElement>('#feedback-gmail-btn');
    const feedbackWhatsappBtn = document.querySelector<HTMLAnchorElement>('#feedback-whatsapp-btn');
    const feedbackCopyBtn = document.querySelector<HTMLButtonElement>('#feedback-copy-btn');
    const copyBtnText = document.querySelector<HTMLElement>('#copy-btn-text');
    const feedbackResetBtn = document.querySelector<HTMLButtonElement>('#feedback-reset-btn');

    let fullEmailText = '';

    contactForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!contactForm.reportValidity()) return;

      const formData = new FormData(contactForm);
      const name = String(formData.get('name') || '').trim();
      const email = String(formData.get('email') || '').trim();
      const brief = String(formData.get('brief') || '').trim();

      const subject = `Consulta de diseño: ${name}`;
      fullEmailText = `Hola Claudio,\n\nSoy ${name} (${email}).\n\nTe contacto por lo siguiente:\n${brief}\n\nQuedo a la espera de tu respuesta. ¡Saludos!`;

      // 1. Mailto Link (triggers default system mail client)
      const mailtoUrl = `mailto:claudiomarcelozelarayan.cmz@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(fullEmailText)}`;
      window.location.href = mailtoUrl;

      // 2. Set up Web Gmail direct fallback
      if (feedbackGmailBtn) {
        feedbackGmailBtn.href = `https://mail.google.com/mail/?view=cm&fs=1&to=claudiomarcelozelarayan.cmz@gmail.com&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(fullEmailText)}`;
      }

      // 3. Set up WhatsApp direct message
      if (feedbackWhatsappBtn) {
        const waText = `Hola Claudio! Soy ${name} (${email}). Te escribo por un proyecto: ${brief}`;
        feedbackWhatsappBtn.href = `https://wa.me/5493815041364?text=${encodeURIComponent(waText)}`;
      }

      // 4. Update Submit Button visual state
      if (contactSubmitBtn && contactBtnLabel && contactBtnIcon) {
        contactBtnLabel.textContent = '¡Mensaje preparado!';
        contactBtnIcon.textContent = '✓';
        contactSubmitBtn.classList.add('is-sent');
      }

      // 5. Reveal feedback banner smoothly
      if (contactFeedback) {
        contactFeedback.hidden = false;
        contactFeedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    // Copy full text button
    feedbackCopyBtn?.addEventListener('click', async () => {
      if (!fullEmailText) return;
      try {
        await navigator.clipboard.writeText(fullEmailText);
        if (copyBtnText) copyBtnText.textContent = '✓ ¡Copiado!';
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = 'Copiar mensaje';
        }, 2500);
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = fullEmailText;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        if (copyBtnText) copyBtnText.textContent = '✓ ¡Copiado!';
        setTimeout(() => {
          if (copyBtnText) copyBtnText.textContent = 'Copiar mensaje';
        }, 2500);
      }
    });

    // Reset button
    feedbackResetBtn?.addEventListener('click', () => {
      contactForm?.reset();
      if (contactFeedback) contactFeedback.hidden = true;
      if (contactSubmitBtn && contactBtnLabel && contactBtnIcon) {
        contactBtnLabel.textContent = 'Preparar mensaje';
        contactBtnIcon.textContent = '↗';
        contactSubmitBtn.classList.remove('is-sent');
      }
    });
  </script>
</Layout>
