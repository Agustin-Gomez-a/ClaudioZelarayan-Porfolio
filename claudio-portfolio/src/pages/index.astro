---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import claudio from '../assets/work/claudio-illustration.jpg';

const projects = [
  {
    number: '01',
    title: 'Balca / Premixer',
    category: 'Branding · Packaging Químico',
    tag: 'branding',
    coverImage: '/img/balcanew.jpg',
    alt: 'Línea de productos químicos y diseño de etiquetas Balca',
    description: 'Desarrollo de identidad visual integral, diseño de etiquetas técnicas para productos químicos, empaques, bidones, flyers y catálogos comerciales para Balca; junto a piezas de comunicación estratégica para Premixer.',
    layout: 'feature',
    tone: 'lime',
    deliverables: ['Identidad Visual', 'Etiquetas Químicas', 'Línea de Packaging', 'Catálogo Comercial'],
    items: [
      {
        type: 'image',
        src: '/img/balcanew.jpg',
        alt: 'Línea completa de productos y etiquetas Balca',
        label: 'Packaging, bidones y etiquetas de productos químicos'
      }
    ]
  },
  {
    number: '02',
    title: 'Gómez Pardo',
    category: 'Retail · Cenefas & Material POP',
    tag: 'branding',
    coverImage: '/img/sorteococacolagomezpardo1.jpg',
    alt: 'Campaña integral de promociones, cenefas y material POP para Megacentro Gómez Pardo',
    description: 'Diseño integral y producción gráfica para campañas y promociones masivas en supermercados e hipermercados Gómez Pardo (Coca-Cola, Formula 1, Monster Energy, etc). Desarrollo de cenefas de góndola para exhibición de precios, material POP para puntos de venta, afiches A3 de vía pública y PDV, cuponeras para buzón de sorteos, creatividades para redes (feed y stories) y spots audiovisuales publicitarios.',
    layout: 'feature',
    tone: 'red',
    deliverables: ['Cenefas de Góndola', 'Material POP', 'Afiches A3 PDV', 'Cuponeras para Sorteos', 'Redes Sociales (Feed & Stories)', 'Spots de Video Promocionales'],
    items: [
      {
        type: 'image',
        src: '/img/sorteococacolagomezpardo1.jpg',
        alt: 'Afiche A3 impreso Sorteo Coca-Cola en Gómez Pardo',
        label: 'Afiche A3 · Sorteo Coca-Cola & Parrilla'
      },
      {
        type: 'image',
        src: '/img/sorteococacolagomezpardo2.jpg',
        alt: 'Cenefa apaisada de góndola para precios de Coca-Cola',
        label: 'Cenefa de Góndola · Precios y Exhibición'
      },
      {
        type: 'image',
        src: '/img/sorteococacolagomezpardo5.jpg',
        alt: 'Cuponera Deposite aquí su cupón para sorteo',
        label: 'Cuponera PDV · "Deposite aquí su cupón"'
      },
      {
        type: 'image',
        src: '/img/sorteococacolagomezpardo3.jpg',
        alt: 'Post para feed de redes sociales Gómez Pardo y Coca-Cola',
        label: 'Redes Sociales · Post Feed (4:5)'
      },
      {
        type: 'image',
        src: '/img/sorteococacolagomezpardo4.jpg',
        alt: 'Story vertical para Instagram 9:16',
        label: 'Redes Sociales · Story Vertical (9:16)'
      },
      {
        type: 'image',
        src: '/img/gomepardosorteoformula1-2.jpg',
        alt: 'Afiche A3 Sorteo F1 Las Vegas y New PGA',
        label: 'Afiche A3 · Sorteo Viaje F1 Las Vegas'
      },
      {
        type: 'image',
        src: '/img/gomepardosorteoformula1.jpg',
        alt: 'Cenefa panorámica para góndola F1 Las Vegas',
        label: 'Cenefa Panorámica · Campaña F1 Las Vegas'
      },
      {
        type: 'image',
        src: '/img/sortegomezpardo1.jpg',
        alt: 'Afiche A3 impreso Sorteo Monster Energy BMX',
        label: 'Afiche A3 · Sorteo Monster Energy BMX'
      },
      {
        type: 'video',
        src: '/video/videopromocionalgomezpardo.mp4',
        alt: 'Spot de video promocional 01 para Gómez Pardo',
        label: 'Spot Audiovisual 01 · Campaña Gómez Pardo'
      },
      {
        type: 'video',
        src: '/video/videopromocionalgomezpardo2.mp4',
        alt: 'Spot de video promocional 02 para Gómez Pardo',
        label: 'Spot Audiovisual 02 · Campaña Gómez Pardo'
      }
    ]
  },
  {
    number: '03',
    title: 'Andrea Sol Creaciones',
    category: 'Identidad · Emprendimientos',
    tag: 'branding',
    coverImage: '/img/andreasolcreaciones.jpg',
    alt: 'Identidad visual completa y packaging para Andrea Sol Creaciones',
    description: 'Sistema de marca cálido y distintivo para emprendimiento creativo. Diseño de imagotipo con sol ilustrado, selección de paleta cromática pastel, diseño de bolsas comerciales (polipropileno y kraft), etiquetas colgantes troqueladas en diversas formas y stickers adhesivos.',
    layout: 'standard',
    tone: 'lilac',
    deliverables: ['Identidad de Marca', 'Bolsas Comerciales', 'Stickers Adhesivos', 'Etiquetas Troqueladas'],
    items: [
      {
        type: 'image',
        src: '/img/andreasolcreaciones.jpg',
        alt: 'Identidad visual, packaging, bolsas y stickers para Andrea Sol Creaciones',
        label: 'Branding, bolsas comerciales, packaging y papelería'
      }
    ]
  },
  {
    number: '04',
    title: 'Humito Artesanal',
    category: 'Ilustración · Branding',
    tag: 'ilustracion',
    coverImage: '/img/humitoartesanal.jpg',
    alt: 'Identidad y personaje ilustrado para Humito Artesanal',
    description: 'Identidad visual urbana y juvenil para Humito Artesanal. Desarrollo de personaje mascota en render 3D e ilustración vectorial, diseño tipográfico personalizado de marca, paleta cromática de alto contraste y set completo de stickers coleccionables para merchandising.',
    layout: 'standard',
    tone: 'pink',
    deliverables: ['Mascota / Personaje', 'Tipografía Personalizada', 'Paleta Cromática', 'Stickers Coleccionables'],
    items: [
      {
        type: 'image',
        src: '/img/humitoartesanal.jpg',
        alt: 'Mascota ilustrada, paleta de color, tipografía y plancha de stickers',
        label: 'Personaje 3D/Vector, identidad visual y plancha de stickers'
      }
    ]
  },
  {
    number: '05',
    title: 'C.A. Tucumán Básquet',
    category: 'Indumentaria · Deporte',
    tag: 'indumentaria',
    coverImage: '/img/camisetaatetlicotucuman1.jpg',
    alt: 'Camiseta oficial de juego para Club Atlético Tucumán Básquet',
    description: 'Diseño integral de indumentaria deportiva para la división de básquetbol del Club Atlético Tucumán. Vectorización y modernización del emblema arquitectónico histórico de la institución, esquema cromático celeste, blanco y dorado, patronaje técnico y mockups publicitarios en cancha.',
    layout: 'standard',
    tone: 'lime',
    deliverables: ['Indumentaria Deportiva', 'Patronaje de Juego', 'Emblema Vectorial', 'Mockups Publicitarios'],
    items: [
      {
        type: 'image',
        src: '/img/camisetaatetlicotucuman1.jpg',
        alt: 'Camiseta oficial de juego C.A. Tucumán Básquet - Mockups y producción',
        label: 'Camiseta oficial de juego · Mockups de partido y modelo'
      },
      {
        type: 'image',
        src: '/img/camisetaatetlicotucuman2.jpg',
        alt: 'Desglose técnico de la camiseta de básquet, logo base y publicidad',
        label: 'Desglose técnico · Logo base, mockups y publicidad en cancha'
      }
    ]
  },
  {
    number: '06',
    title: 'Chupetín Cotillón',
    category: 'Ilustración · Identidad',
    tag: 'ilustracion',
    coverImage: '/img/chupetincotillon.jpg',
    alt: 'Identidad de marca y personaje chibi para Chupetín Cotillón',
    description: 'Desarrollo de identidad visual e ilustración de personaje en estilo chibi para repostería y cotillón infantil. Creación de logotipo titular dinámico, tarjetas personales para clientes, marcos gráficos para redes sociales y versiones vectoriales en positivo y negativo para sellos y embalaje.',
    layout: 'standard',
    tone: 'lilac',
    deliverables: ['Ilustración Chibi', 'Logotipo Ilustrado', 'Tarjetas Comerciales', 'Marcos para Redes'],
    items: [
      {
        type: 'image',
        src: '/img/chupetincotillon.jpg',
        alt: 'Personaje chibi ilustrado, logotipo, tarjetas comerciales y versiones vectoriales',
        label: 'Personaje chibi, logotipo, tarjetas comerciales y versiones vectoriales'
      }
    ]
  },
  {
    number: '07',
    title: 'Diseño de Camisetas Propias',
    category: 'Indumentaria · Streetwear',
    tag: 'indumentaria',
    coverImage: '/img/remeradiseñopropio.jpg',
    alt: 'Colección de remeras gráficas con ilustración y estampa original',
    description: 'Línea de diseño textil y streetwear con arte e ilustraciones originales de autor creadas por Claudio. Diseños de alto impacto visual listos para separación de colores, serigrafía y estampado DTF con motivos de fuego, calaveras, corazones espinados, encendedores y estética tattoo.',
    layout: 'feature',
    tone: 'red',
    deliverables: ['Diseño Textil', 'Ilustración Streetwear', 'Separación de Colores', 'Estampas Serigrafía & DTF'],
    items: [
      {
        type: 'image',
        src: '/img/remeradiseñopropio.jpg',
        alt: 'Colección de 6 remeras gráficas con ilustración y estampa original',
        label: 'Colección de 6 remeras gráficas · Streetwear & Estampa Textil'
      },
      {
        type: 'image',
        src: '/img/flyertucuman-tattoshow.jpg',
        alt: 'Afiche ilustrado para Tucumán Tattoo Show 3',
        label: 'Afiche ilustrado · Tucumán Tattoo Show 3'
      },
      {
        type: 'image',
        src: '/img/flashtatooweekend.jpg',
        alt: 'Flyer promocional para Flash Tattoo Weekend',
        label: 'Flyer promocional · Flash Tattoo Weekend'
      }
    ]
  }
];

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/cclaud10ss/' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/claudio-zelarayan-878120231/' },
  { label: 'Facebook', href: 'https://www.facebook.com/cclaud10ss/' },
];
---

<Layout
  title="Claudio Zelarayan — Diseñador gráfico"
  description="Portfolio de Claudio Zelarayan, diseñador gráfico freelance en Tucumán. Branding, packaging, ilustración y diseño digital. Más de 5 años de experiencia y 100+ proyectos."
>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <div class="scroll-progress" aria-hidden="true"><span id="scroll-progress-bar"></span></div>

  <header class="site-header" id="inicio">
    <a class="brand-mark" href="#inicio" aria-label="Claudio Zelarayan, inicio">
      <span class="brand-monogram">
        <span class="monogram-text">Cz</span>
      </span>
      <span class="brand-name">Claudio<br />Zelarayan</span>
    </a>
    <nav class="desktop-nav" aria-label="Navegación principal">
      <a href="#trabajos">Trabajos <span>07</span></a>
      <a href="#sobre-mi">Sobre mí</a>
      <a class="nav-contact" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
    </nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú">
      <span></span><span></span>
    </button>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Navegación móvil" hidden>
      <a href="#trabajos">Trabajos <span>07</span></a>
      <a href="#sobre-mi">Sobre mí</a>
      <a href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
    </nav>
  </header>

  <main id="contenido">
    <section class="hero section-pad" aria-labelledby="hero-title">
      <div class="hero-ambient" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow"><span class="availability-dot"></span> Diseñador gráfico · Tucumán, Argentina</p>
        <h1 id="hero-title">
          Diseño que<br />
          <span class="hero-title-accent-line"><span>hace&nbsp;</span><span class="typewriter-wrap"><em class="typewriter-word" id="typewriter-text">ruido.</em><span class="typewriter-cursor" aria-hidden="true"></span></span></span>
        </h1>
        <div class="hero-bottom">
          <p class="hero-intro">Le doy forma a ideas con carácter. <strong>Marcas, imágenes y experiencias</strong> que se hacen notar y se quedan en la memoria.</p>
          <div class="hero-actions">
            <a class="hero-cta-primary" href="#trabajos" aria-label="Explorar proyectos">
              <span>Explorar trabajos</span>
              <span class="cta-arrow-circle" aria-hidden="true">↓</span>
            </a>
            <a class="hero-cta-secondary" href="#contacto" aria-label="Ir a contacto">
              <span>Hablemos</span>
              <span class="cta-arrow-corner" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
      <div class="hero-art" aria-label="Retrato ilustrado de Claudio Zelarayan">
        <div class="hero-art-grid" aria-hidden="true"></div>
        <div class="hero-sticker sticker-top" aria-hidden="true"><span>Ideas</span><span>con</span><span>actitud</span></div>
        <div class="hero-image-frame" data-parallax="0.04">
          <Image src={claudio} alt="Retrato ilustrado de Claudio Zelarayan" widths={[420, 680, 900]} sizes="(max-width: 800px) 80vw, 42vw" format="webp" quality={84} loading="eager" fetchpriority="high" />
        </div>
        <div class="hero-art-orbit" aria-hidden="true">C</div>
        <p class="hero-art-note" aria-hidden="true"><span>Diseño</span><span>con intención</span></p>
        <span class="hero-spark hero-spark-one" aria-hidden="true">✳</span>
        <span class="hero-spark hero-spark-two" aria-hidden="true">+</span>
      </div>
      <div class="hero-index" aria-hidden="true"><span>01</span><span class="hero-index-line"></span><span>Scroll para descubrir</span></div>
    </section>

    <div class="ticker" aria-label="Branding, packaging, ilustración y diseño digital">
      <div class="ticker-inner">
        <div class="ticker-track" aria-hidden="true">
          {Array.from({ length: 8 }).map(() => (
            <span class="ticker-chunk">
              <span>Branding</span><i class="ticker-dot">✳</i>
              <span>Packaging</span><i class="ticker-dot">✳</i>
              <span>Ilustración</span><i class="ticker-dot">✳</i>
              <span>Diseño digital</span><i class="ticker-dot">✳</i>
            </span>
          ))}
        </div>
      </div>
    </div>

    <section class="work-section section-pad" id="trabajos" aria-labelledby="work-title">
      <div class="section-heading" data-reveal>
        <div class="section-heading-main">
          <p class="eyebrow eyebrow-dark"><span>01</span> Selección de trabajos</p>
          <h2 id="work-title">Una idea.<br /><em>Muchas formas.</em></h2>
        </div>
        <div class="work-statement-card">
          <span class="statement-badge">Manifiesto visual</span>
          <p class="statement-lead">
            Identidades que cuentan <strong>historias</strong>.<br />
            Piezas hechas para vivir en una <strong>pantalla</strong>, en la <strong>calle</strong> y en las <strong>manos</strong>.
          </p>
        </div>
      </div>

      <!-- Project Category Filters -->
      <div class="project-filters" data-reveal role="tablist" aria-label="Filtrar proyectos">
        <button class="filter-pill is-active" type="button" data-filter="all">Todos <span>(07)</span></button>
        <button class="filter-pill" type="button" data-filter="branding">Branding & Retail <span>(03)</span></button>
        <button class="filter-pill" type="button" data-filter="ilustracion">Ilustración & Mascota <span>(02)</span></button>
        <button class="filter-pill" type="button" data-filter="indumentaria">Indumentaria & Textil <span>(02)</span></button>
      </div>

      <div class="project-grid" id="project-grid">
        {projects.map((project, index) => (
          <article
            class:list={["project-card", `project-card--${project.layout}`, `project-card--${project.tone}`]}
            data-reveal
            data-category={project.tag}
          >
            <button
              class="project-card-button"
              type="button"
              aria-haspopup="dialog"
              aria-label={`Ver proyecto ${project.title}`}
              data-project-index={index}
            >
              <span class="project-image-wrap">
                <img src={project.coverImage} alt={project.alt} loading="lazy" class="project-thumb-img" />
                <span class="project-image-shade" aria-hidden="true"></span>
                <span class="project-open" aria-hidden="true">↗</span>
                <span class="project-number">{project.number} / 07</span>
                {project.items.length > 1 && (
                  <span class="project-media-count" title={`${project.items.length} recursos disponibles`}>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M20.4 14.5L16 10 4 20"/></svg>
                    <span>{project.items.length} recursos</span>
                  </span>
                )}
              </span>
              <span class="project-meta">
                <span><span class="project-category">{project.category}</span><strong>{project.title}</strong></span>
                <span class="project-arrow" aria-hidden="true">↗</span>
              </span>
            </button>
          </article>
        ))}
      </div>

      <div class="work-footnote" data-reveal><span>Un archivo en constante movimiento</span><span class="footnote-line"></span><span>2021 — hoy</span></div>
    </section>

    <section class="case-section" aria-labelledby="case-title">
      <div class="case-visual" data-reveal>
        <div class="case-stamp" aria-hidden="true">CASO<br />DESTACADO<br /><span>№ 01</span></div>
        <div class="case-image" data-parallax="0.03">
          <img src="/img/balcanew.jpg" alt="Línea de productos químicos y empaques diseñada para Balca" loading="lazy" class="case-featured-img" />
        </div>
        <span class="case-corner-mark" aria-hidden="true">✳</span>
      </div>
      <div class="case-copy" data-reveal>
        <p class="eyebrow"><span>Un proyecto, de punta a punta</span></p>
        <h2 id="case-title">Balca<br /><em>se pone</em><br />en marcha.</h2>
        <p>Identidad visual para una empresa de químicos: logotipo, etiquetas, empaques, flyers y catálogos. También piezas gráficas para Premixer, con una misma prioridad: que cada marca comunique claro y con coherencia.</p>
      <div class="case-tags flex flex-wrap gap-2"><span>Identidad</span><span>Packaging</span><span>Impresos</span></div>
        <a class="text-link text-link-light" href="#contacto">¿Tenés un proyecto parecido? <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="about-section section-pad" id="sobre-mi" aria-labelledby="about-title">
      <div class="about-kicker" data-reveal><p class="eyebrow eyebrow-dark"><span>02</span> Un poco sobre mí</p><span class="about-asterisk" aria-hidden="true">✳</span></div>
      <div class="about-main">
        <div class="about-statement" data-reveal>
          <h2 id="about-title">No hago<br />diseños <em>porque sí.</em></h2>
          <p>Me gusta encontrar lo que hace única a cada idea y convertirlo en una imagen que conecte. Soy Claudio, diseñador gráfico freelance, curioso por naturaleza y fan de los detalles que cambian todo.</p>
          <a class="text-link" href="#contacto">Conoceme en un proyecto <span aria-hidden="true">↗</span></a>
        </div>
        <div class="about-facts" data-reveal>
          <div class="fact">
            <strong class="stat-counter" data-count-target="5" data-count-prefix="0" data-count-suffix="+">05<span>+</span></strong>
            <span>Años haciendo<br />que las ideas se vean</span>
          </div>
          <div class="fact">
            <strong class="stat-counter" data-count-target="100" data-count-prefix="" data-count-suffix="+">100<span>+</span></strong>
            <span>Proyectos<br />en el camino</span>
          </div>
          <div class="fact-location"><span class="availability-dot"></span> Tucumán, Argentina<br /><span>Trabajo con marcas de cualquier lugar.</span></div>
        </div>
      </div>
      <div class="about-bottom"><span>Una mirada curiosa</span><span>Una identidad propia</span><span>Un resultado que funciona</span></div>
    </section>

    <section class="services-section section-pad" aria-labelledby="services-title">
      <div class="services-intro" data-reveal>
        <p class="eyebrow"><span>03</span> Qué puedo hacer por tu marca</p>
        <h2 id="services-title">Del primer<br /><em>trazo al mundo.</em></h2>
      </div>
      <div class="services-list">
        <article class="service-item" data-reveal>
          <span class="service-no">01</span><h3>Identidad de marca</h3><p>Logotipo, sistema visual y lineamientos para que tu marca se reconozca en todos sus puntos de contacto.</p><span class="service-glyph" aria-hidden="true">✳</span>
        </article>
        <article class="service-item" data-reveal>
          <span class="service-no">02</span><h3>Packaging & impresos</h3><p>Etiquetas, empaques, catálogos, flyers y piezas listas para salir del archivo y llegar a la gente.</p><span class="service-glyph" aria-hidden="true">▧</span>
        </article>
        <article class="service-item" data-reveal>
          <span class="service-no">03</span><h3>Diseño digital</h3><p>Piezas para redes, campañas y experiencias web pensadas para verse bien y comunicar rápido.</p><span class="service-glyph" aria-hidden="true">↗</span>
        </article>
        <article class="service-item" data-reveal>
          <span class="service-no">04</span><h3>Ilustración</h3><p>Personajes, recursos y arte original para sumar personalidad a una idea, una prenda o una historia.</p><span class="service-glyph" aria-hidden="true">⌁</span>
        </article>
      </div>
    </section>

    <!-- Caja de Herramientas Renovada con Entidad y Estructura -->
    <section class="toolbelt-section section-pad" aria-labelledby="toolbelt-title">
      <div class="toolbelt-header" data-reveal>
        <div class="toolbelt-heading">
          <p class="eyebrow toolbelt-eyebrow"><span>04 · Dominio técnico & software</span></p>
          <h2 id="toolbelt-title">Mi caja de<br /><em>herramientas.</em></h2>
        </div>
        <p class="toolbelt-lead">
          El criterio no sirve si no sabés ejecutarlo. Manejo software profesional de la industria y procesos de producción técnica para llevar cualquier idea de la pantalla a la calle, la tela o la imprenta.
        </p>
      </div>

      <div class="toolbelt-grid">
        <article class="tool-card tool-card--ps" data-reveal>
          <div class="tool-card-head">
            <span class="tool-icon tool-icon--ps">Ps</span>
            <span class="tool-pill">Adobe</span>
          </div>
          <h3>Photoshop</h3>
          <p class="tool-desc">Retoque digital avanzado, fotomontajes de alto impacto, texturas, corrección de color y arte final publicitario.</p>
          <span class="tool-feature">Retoque & Composición</span>
        </article>

        <article class="tool-card tool-card--ai" data-reveal>
          <div class="tool-card-head">
            <span class="tool-icon tool-icon--ai">Ai</span>
            <span class="tool-pill">Adobe</span>
          </div>
          <h3>Illustrator</h3>
